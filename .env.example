# =============================================================================
# SCHOLAR AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# --- FRONTEND CONFIGURATION (React + Vite) ---
# Local: http://localhost:8000/api
# Production: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Supabase Auth & Public Client
VITE_SUPABASE_URL=https://gixgyrsyopwtfgxvfglp.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- BACKEND CONFIGURATION (Java Spring Boot) ---
# Server Port (Local: 8000, Cloud/Heroku/Render: ${PORT})
PORT=8000

# Supabase PostgreSQL Session Pooler Connection (IPv4 Compatible on Port 5432)
# Obtain from: Supabase Dashboard -> Connect -> JDBC -> Session Pooler
SUPABASE_DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=<your_rotated_db_password>

# Supabase JWT Secret for token verification
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,https://yourdomain.com

